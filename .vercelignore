# Nothing in here is part of the site. Keeping it out of the upload is the real
# fix: a file that never reaches the CDN cannot be served, whereas a redirect
# rule only hides one that did. The redirects block in vercel.json is the
# second line of defence in case a file lands here some other way.
.git
.gitignore
.github
test/
build.py
*.md
IT-REVIEW.html
Testbench-IT-review.pdf
_redirects
dist/
docs/

# Vercel reads package.json and runs whatever "build" script it finds. There is
# no build here, so the safest thing is for the host not to see a Node project
# at all. Playwright is a test-time tool; none of this belongs in a deploy.
package.json
package-lock.json
node_modules
